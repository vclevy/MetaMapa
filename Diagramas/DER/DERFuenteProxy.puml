@startuml
'https://plantuml.com/class-diagram

entity hechos {
  * id : INTEGER(11) «PK»
 * categoria_id : INTEGER(11) «FK»
  * coleccion_id : INTEGER(11) «FK»
 *   contribuyente_id :INTEGER(11) «FK»
  --
  titulo : VARCHAR(255)
  descripcion : TEXT
  fecha_acontecimiento: DATE
  updated_at: DATE
  created_at: DATE
  origen : ENUM(DATASET, CARGA_MANUAL, CONTRIBUYENTE)
  es_anonimo : BOOLEAN
  fue_eliminado: BOOLEAN
  contribuyente_id
}

entity colecciones {
  * id : INTEGER(11) «PK»
  --
  titulo : VARCHAR(255)
  descripcion : TEXT
}
entity "lugar"  {
  * id : INTEGER(11) «PK»
  --
  fecha : date
  total : decimal
}

entity "categorias"  {
  *id : INTEGER(11) «PK»
  --
  nombre : VARCHAR(100)
}

entity solicitudes  {
  * id : INTEGER(11) «PK»
  * hecho_id : INTEGER(11) «FK»
  --
justifiacion: TEXT
estado: ENUM(PENDIENTE,RECHAZADA,APROBADA)
fecha_solicitud : DATE
}


entity "hecho_multimedia" {
  * hecho_id : INTEGER(11) «FK»
  --
  url: VARCHAR(255)
}

hechos ||--|| lugar
categorias ||--o{ hechos
colecciones ||--o{ hechos
hechos ||--o{ hecho_multimedia
hechos ||--o{ solicitudes


@enduml

