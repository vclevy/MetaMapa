@startuml
left to right direction

'==== PAQUETE: Dominio Principal ===='
package "Dominio" {
    class Categoria {
        - nombre : String
    }

    class Lugar {
        - nombre : String
        - latitud : Double
        - longitud : Double
    }

    class Etiqueta {
        - nombre : String
        - descripcion : String
    }

    abstract class Hecho {
        # titulo : String
        # descripcion : String
        # categoria : Categoria
        # fechaDeAcontecimiento : LocalDateTime
        # fechaDeCarga : LocalDateTime
        # lugar : Lugar
        # origen : OrigenDelHecho
        # solicitudesDeEliminacion : List<Solicitud>
        # esAnonimo : Boolean
        # etiqueta : Etiqueta

        + agregarSolicitudDeEliminacion(unaSolicitud : Solicitud) : void
    }

    class HechoDeTexto extends Hecho
}

'==== PAQUETE: Colecciones ===='
package "Colecciones" {
    class Coleccion {
        - titulo : String
        - descripcion : String
        - hechos : List<Hecho>

        + agregarHechos(unosHechos : Hecho...) : void
        + eliminarHecho(unHecho : Hecho) : void
    }
}

'==== PAQUETE: Filtros ===='
package "Filtros" {
    interface FiltroHecho {
        + aplica(unHecho : Hecho) : boolean
    }

    class FiltroHechoPorAnonimato implements FiltroHecho {
        - esAnonimo : boolean
        + aplica(unHecho : Hecho) : boolean
    }

    class FiltroHechoPorCategoria implements FiltroHecho {
        - categoria : Categoria
        + aplica(unHecho : Hecho) : boolean
    }

    class FiltroHechoPorLugar implements FiltroHecho {
        - lugar : Lugar
        + aplica(unHecho : Hecho) : boolean
    }
}

'==== PAQUETE: Fuentes ===='
package "Fuentes de Datos" {
    interface OrigenDelHecho {
        + cargarHecho(unHecho : Hecho) : void
    }

    class CargaManual implements OrigenDelHecho
    class Contribuyente implements OrigenDelHecho
    class DataSet implements OrigenDelHecho
}

'==== PAQUETE: Usuarios ===='
package "Usuarios" {
    enum TipoDeUsuario {
        CONTRIBUYENTE
        VISUALIZADOR
    }

    class Usuario {
        - nombre : String
        - apellido : String
        - edad : Integer
        - tipoDeUsuario : TipoDeUsuario

        + subirHecho(unHecho : Hecho) : void
        + solicitarBorrarUnHecho(unHecho : Hecho) : void
        + visualizar(unaColeccion : Coleccion) : void
        + navegar(unaColeccion : Coleccion, unFiltro : FiltroHecho) : void
    }

    class Administrador {
        - nombre : String
        - solicitudesDeEliminacion : List<Solicitud>

        + importarHecho(unaColeccion : Coleccion, unaRutaDeArchivo : String) : void
        + crearColeccion(unTitulo : String, unaDescripcion : String) : Coleccion
        + getSolicitudesDeEliminacionPendientes() : List<Solicitud>
        + solicitudesValidas() : List<Solicitud>
        + evaluarSolicitud() : void
        + aprobarSolicitud(unaSolicitud : Solicitud) : void
        + rechazarSolicitud(unaSolicitud : Solicitud) : void
    }
}

'==== PAQUETE: Sistema ===='
package "Sistema" {
    class RepositorioHechosDinamicos {
        - hechosSubidos : List<Hecho>
        + agregarHechos(unosHechos : Hecho...) : void
    }

    class Solicitud {
        - justificacion : String
        - hecho : Hecho
        - estado : EstadoDeSolicitudDeEliminacion
    }

    enum EstadoDeSolicitudDeEliminacion {
        PENDIENTE
        APROBADA
        RECHAZADA
    }
}

'==== RELACIONES ===='
Hecho --> Categoria
Hecho --> Lugar
Hecho --> Etiqueta
Hecho --> OrigenDelHecho
Hecho --> Solicitud

Coleccion --> Hecho
Usuario --> Coleccion
Usuario --> Hecho
Usuario --> FiltroHecho

Administrador --> Coleccion
Administrador --> Solicitud
Administrador --> Hecho

FiltroHechoPorCategoria --> Categoria
FiltroHechoPorLugar --> Lugar

Solicitud --> Hecho
RepositorioHechosDinamicos --> Hecho

FiltroHecho <|.. FiltroHechoPorAnonimato
FiltroHecho <|.. FiltroHechoPorCategoria
FiltroHecho <|.. FiltroHechoPorLugar

OrigenDelHecho <|.. CargaManual
OrigenDelHecho <|.. Contribuyente
OrigenDelHecho <|.. DataSet

Hecho <|-- HechoDeTexto

@enduml
